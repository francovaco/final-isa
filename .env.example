# Copiar a .env y cambiar los valores (el archivo .env no se sube al repo).
# Para generar valores al azar:  openssl rand -hex 16   /   openssl rand -hex 32

# --- App ---
# Secreto para firmar los tokens JWT (base64, 64 bytes):  openssl rand -base64 64 | tr -d '\n'
JWT_BASE64_SECRET=cambiar-por-un-secreto-en-base64
# Contraseña de la base de datos PostgreSQL de la app
POSTGRES_PASSWORD=cambiar-postgres

# --- ELK ---
# Usuario administrador de Elasticsearch/Kibana (login en http://localhost:5601: elastic / este valor)
ELASTIC_PASSWORD=cambiar-elastic
# Usuario interno que usa Kibana para conectarse a Elasticsearch
KIBANA_SYSTEM_PASSWORD=cambiar-kibana-system
# Usuario interno que usa Logstash para escribir los logs
LOGSTASH_INTERNAL_PASSWORD=cambiar-logstash-internal
# Clave de cifrado de Kibana (32 caracteres o más): necesaria para las alertas
KIBANA_ENCRYPTION_KEY=cambiar-por-una-clave-de-32-caracteres-o-mas
